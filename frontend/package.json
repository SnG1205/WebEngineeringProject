{
  "name": "WebEngineeringProject",
  "version": "1.0.0",
  "description": "This repository is designed as the foundation for coding playgrounds in the Web Engineering course. It offers a structured space for experimenting with and mastering various web development technologies and practices. \r The project is based on [this](https://developer.mozilla.org/en-US/docs/Learn/Accessibility/Accessibility_troubleshooting) repository from MDN.",
  "main": "index.js",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint frontend/modules/*.{js,ts}",
    "lint:fix": "eslint frontend/modules/*.{js,ts} --fix",
    "format": "prettier --write frontend/modules/*.{js,ts}",
    "format:check": "prettier --check frontend/modules/*.{js,ts}",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "modules/*.{js,ts}": [
      "npm run lint:fix",
      "npm run format"
    ]
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "svelte": "^5.43.8",
    "vite": "7.1.11",
    "@sveltejs/adapter-static": "^3.0.10"
  }
}
