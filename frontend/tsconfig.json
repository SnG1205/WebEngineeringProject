{
  "extends": "../.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "strictNullChecks": true,
    "module": "ESNext", //Mb not necessary
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false
  },
  "include": [
    "frontend/modules/*.ts",
    "src/app.html",
    "frontend/src/components/*.svelte"
  ]
}